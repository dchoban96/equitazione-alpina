---
import type { Crumb } from '../lib/content';
import { url } from '../lib/content';

interface Props {
  crumbs: Crumb[];
  label: string;
}
const { crumbs, label } = Astro.props;
---

{
  crumbs.length > 1 && (
    <nav class="crumbs" aria-label={label}>
      <ol>
        {crumbs.map((c, i) =>
          i === crumbs.length - 1 ? (
            <li aria-current="page">{c.label}</li>
          ) : (
            <li>
              <a href={url(c.href)}>{c.label}</a>
            </li>
          ),
        )}
      </ol>
    </nav>
  )
}
