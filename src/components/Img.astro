---
/* Every image goes through astro:assets: AVIF with a WebP fallback, widths
   480-1600, explicit width and height. Below the fold it is lazy; the hero
   is eager with high fetch priority. `focus` ("x% y%") is the point that
   stays in view when a .frame crops the photo (see .frame img in base.css). */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { widthsFor } from '../lib/images';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  priority?: boolean;
  class?: string;
  focus?: string;
}
const { src, alt, sizes, priority = false, class: cls, focus } = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  widths={widthsFor(src)}
  sizes={sizes}
  formats={['avif']}
  fallbackFormat="webp"
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={cls}
  style={focus ? `--focus:${focus}` : undefined}
/>
