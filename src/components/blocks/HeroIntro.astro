---
/* Opening, layout "intro": a large photo panel inside the page margins.
   On arrival the photo starts as a small, slightly tilted print in the middle
   and opens out to the whole panel; then the title, the intro and the
   buttons rise in at the bottom of it. Reduced motion: the panel is there at once. */
import type { Block } from '../../lib/content';
import { url } from '../../lib/content';
import Img from '../Img.astro';
import { txt, md } from '../../lib/text';

interface Props {
  block: Extract<Block, { type: 'hero' }>;
  draft: boolean;
  ui: Record<string, string>;
}
const { block: b, draft, ui } = Astro.props;
const intro = await md(b.intro);
---

<section class="blk blk--hero blk--hero--intro" id={b.anchor} data-altitude={b.altitude}>
  <div class="blk__in">
    <div class="hero-intro">
      <div class="hero-intro__photo">
        <Img src={b.image!} alt={b.imageAlt ?? ''} focus={b.focus} sizes="(min-width: 1320px) 1220px, 100vw" priority />
      </div>
      <div class="hero-intro__text">
        {b.kicker && <p class="kicker" set:html={txt(b.kicker)} />}
        <h1>
          <Fragment set:html={txt(b.title)} />
          {draft && <span class="draft-badge">{ui.draftBadge}</span>}
        </h1>
        {intro && <div class="hero__intro prose" set:html={intro} />}
        {
          b.actions?.length ? (
            <p class="hero__actions">
              {b.actions.map((a, i) => (
                <a class:list={['btn', { 'btn--ghost': i > 0 }]} href={url(a.link)} set:html={txt(a.label)} />
              ))}
            </p>
          ) : null
        }
      </div>
    </div>
  </div>
</section>
