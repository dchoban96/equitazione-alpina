---
/* Page opening (ea-hero): coordinates line, H1, intro, closing line, footnote,
   optional photo with a data panel over it. The mountain ridges are drawn by
   the layout on every page (site setting `ridges`).
   layout "cover": the photo fills the screen and everything sits on it, the
   breadcrumb included (the layout leaves it out); the panel becomes the
   figures beside the text, and `actions` the buttons under it. */
import type { Block, Crumb } from '../../lib/content';
import { url } from '../../lib/content';
import Img from '../Img.astro';
import Breadcrumb from '../Breadcrumb.astro';
import { txt, md } from '../../lib/text';

interface Props {
  block: Extract<Block, { type: 'hero' }>;
  draft: boolean;
  ui: Record<string, string>;
  crumbs?: Crumb[];
}
const { block: b, draft, ui, crumbs = [] } = Astro.props;
const intro = await md(b.intro);
const cover = b.layout === 'cover' && Boolean(b.image);
const videoSrc = b.video && import.meta.env.BASE_URL.replace(/\/$/, '') + b.video;
---

{
  cover ? (
    <section class="blk blk--hero blk--hero--cover" id={b.anchor} data-altitude={b.altitude} data-cover>
      <div class="hero__bg">
        <Img src={b.image!} alt={b.imageAlt ?? ''} focus={b.focus} sizes="100vw" priority />
        {videoSrc && <video class="hero__video" data-src={videoSrc} muted loop playsinline preload="none" aria-hidden="true" />}
      </div>
      <div class="blk__in">
        <div class="hero-seq">
          {crumbs.length > 1 ? <Breadcrumb crumbs={crumbs} label={ui.breadcrumbLabel} /> : b.kicker && <p class="kicker" set:html={txt(b.kicker)} />}
          <h1>
            <Fragment set:html={txt(b.title)} />
            {draft && <span class="draft-badge">{ui.draftBadge}</span>}
          </h1>
          {intro && <div class="hero__intro prose" set:html={intro} />}
          {b.actions?.length ? (
            <p class="hero__actions">
              {b.actions.map((a, i) => (
                <a class:list={['btn', { 'btn--ghost': i > 0 }]} href={url(a.link)} set:html={txt(a.label)} />
              ))}
            </p>
          ) : null}
        </div>
        {b.panel?.length ? (
          <dl class="hero__figures">
            {b.panel.map((r) => (
              <div>
                <dt set:html={txt(r.label)} />
                <dd set:html={txt(r.value)} />
              </div>
            ))}
          </dl>
        ) : null}
      </div>
    </section>
  ) : (
<section class:list={['blk blk--hero', { 'blk--hero--photo-first': b.image && b.panel }]} id={b.anchor} data-altitude={b.altitude}>
  <div class="blk__in">
    <div class="hero-seq">
      {b.coordinates && <p class="hero__coords" set:html={txt(b.coordinates)} />}
      {b.kicker && <p class="kicker" set:html={txt(b.kicker)} />}
      <h1>
        <Fragment set:html={txt(b.title)} />
        {draft && <span class="draft-badge">{ui.draftBadge}</span>}
      </h1>
      {intro && <div class="hero__intro prose" set:html={intro} />}
      {b.closing && <p class="hero__closing" set:html={txt(b.closing)} />}
      {b.footnote && <p class="hero__foot" set:html={txt(b.footnote)} />}
    </div>
    {
      b.image && (
        <div class="hero__media split split--overlay">
          <div class="frame">
            <Img src={b.image} alt={b.imageAlt ?? ''} focus={b.focus} sizes="(min-width: 1320px) 1220px, 100vw" priority />
            {b.video && (
              <video
                class="hero__video"
                data-src={import.meta.env.BASE_URL.replace(/\/$/, '') + b.video}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
              />
            )}
          </div>
          {b.panel && (
            <div class="split__text">
              {b.panelKicker && <p class="kicker" set:html={txt(b.panelKicker)} />}
              <dl class="details">
                {b.panel.map((r) => (
                  <div>
                    <dt set:html={txt(r.label)} />
                    <dd set:html={txt(r.value)} />
                  </div>
                ))}
              </dl>
            </div>
          )}
        </div>
      )
    }
  </div>
</section>
  )
}

<script>
  /* The hero clip loads only when motion is welcome and data is not being
     saved; it fades in over the photo once it actually plays. */
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (!reduced && !saveData) {
    document.querySelectorAll<HTMLVideoElement>('.hero__video[data-src]').forEach((v) => {
      v.addEventListener('playing', () => v.classList.add('is-playing'), { once: true });
      // Muted autoplay: the browser starts it, and pauses it off screen.
      v.autoplay = true;
      v.src = v.dataset.src!;
    });
  }

  /* Full-screen opening: while it is under the header, <html> gets `on-cover`
     (white header, no altimeter); scrolling past it brings the usual look back. */
  const cover = document.querySelector<HTMLElement>('[data-cover]');
  if (cover) {
    const update = () => {
      const header = document.querySelector<HTMLElement>('[data-header]')?.getBoundingClientRect().bottom ?? 80;
      document.documentElement.classList.toggle('on-cover', cover.getBoundingClientRect().bottom > header);
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
  }
</script>
