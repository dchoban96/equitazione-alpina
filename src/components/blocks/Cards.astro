---
/* Grid of short items: small tiles (ea-griglia "servizi") or cards with a
   photo and a link (ea-card). */
import type { Block } from '../../lib/content';
import Section from './Section.astro';
import Img from '../Img.astro';
import { md, txt } from '../../lib/text';
import { hiddenPaths, leadsToHidden, url } from '../../lib/content';

interface Props {
  block: Extract<Block, { type: 'cards' }>;
  id: string;
}
const { block: b, id } = Astro.props;
// a card presenting a page hidden in the control panel is left out; with none left, so is the block
const hidden = await hiddenPaths();
const items = await Promise.all(
  b.items.filter((i) => !leadsToHidden(i.link, hidden)).map(async (i) => ({ ...i, html: await md(i.text) })),
);
---

{items.length > 0 && (
<Section {...b} headingId={id}>
  {
    b.style === 'tiles' ? (
      <ul class="grid grid--auto">
        {items.map((i) => (
          <li class="tile">
            <h3 set:html={txt(i.title)} />
            {i.html && <div class="prose" set:html={i.html} />}
            {i.link && <a class="tile__link" href={url(i.link)} set:html={txt(i.label ?? i.title)} />}
          </li>
        ))}
      </ul>
    ) : (
      <ul class="cards">
        {items.map((i) => (
          <li class="card">
            {i.image && (
              <div class="frame">
                <Img src={i.image} alt={i.alt ?? ''} focus={i.focus} sizes="(min-width: 1024px) 400px, (min-width: 600px) 50vw, 100vw" />
              </div>
            )}
            <h3 set:html={txt(i.title)} />
            {i.html && <div class="prose" set:html={i.html} />}
            {i.link && <a class="tile__link" href={url(i.link)} set:html={txt(i.label ?? i.title)} />}
          </li>
        ))}
      </ul>
    )
  }
</Section>
)}
