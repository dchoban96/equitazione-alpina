---
/* Shell shared by every block: anchor id, altitude for the altimeter,
   scroll reveal, and the optional kicker / note / heading.
   An "aside" slot (a photo) puts the content in two columns: the aside on
   the left, heading and content on the right (see .blk__in--aside). */
import SectionHead from './SectionHead.astro';

interface Props {
  type: string;
  altitude?: number;
  anchor?: string;
  kicker?: string;
  note?: string;
  heading?: string;
  reveal?: boolean;
  line?: boolean;
  class?: string;
  headingId?: string;
}
const { type, altitude, anchor, kicker, note, heading, reveal = true, line = false, class: cls, headingId } = Astro.props;
// With an altitude and no other note, the altitude is written next to the kicker.
const shownNote = note ?? (altitude !== undefined ? `${altitude} m` : undefined);
const hasHead = Boolean(kicker || heading);
const hasAside = Astro.slots.has('aside');
const head = { kicker, note: shownNote, heading, headingId };
---

<section
  class:list={['blk', `blk--${type}`, { reveal, 'blk--line': line }, cls]}
  id={anchor}
  data-altitude={altitude}
  aria-labelledby={heading ? headingId : undefined}
>
  {
    hasAside ? (
      <div class="blk__in blk__in--aside">
        <div class="blk__aside">
          <slot name="aside" />
        </div>
        <div class="blk__copy">
          {hasHead && (
            <SectionHead {...head}>
              <slot name="head" />
            </SectionHead>
          )}
          <slot />
        </div>
      </div>
    ) : (
      <div class="blk__in">
        {hasHead && (
          <SectionHead {...head}>
            <slot name="head" />
          </SectionHead>
        )}
        <slot />
      </div>
    )
  }
</section>
