---
/* Full gallery with a hand-written lightbox: keyboard (arrows, Escape),
   swipe, focus kept inside, caption, and a URL fragment per photo
   (#foto-3) so a photo can be linked. Without JavaScript each thumbnail
   links to the large image. */
import { getEntry } from 'astro:content';
import type { Block } from '../../lib/content';
import Section from './Section.astro';
import Img from '../Img.astro';
import { txt } from '../../lib/text';
import { lightboxSources } from '../../lib/images';

interface Props {
  block: Extract<Block, { type: 'gallery' }>;
  id: string;
  ui: Record<string, string>;
}
const { block: b, id, ui } = Astro.props;
const gallery = await getEntry('galleries', b.gallery);
if (!gallery) throw new Error(`gallery: no gallery "${b.gallery}" in src/content/it/galleries/`);

const photos = await Promise.all(
  gallery.data.photos.map(async (p, i) => {
    const caption = [p.caption, p.place, p.altitude !== undefined ? `${p.altitude} ${ui.altimeterUnit}` : undefined]
      .filter(Boolean)
      .join(' · ');
    return { ...p, n: i + 1, caption, large: await lightboxSources(p.file) };
  }),
);
---

<Section {...b} headingId={id}>
  {
    photos.length === 0 ? (
      <p set:html={txt(ui.galleryEmpty)} />
    ) : (
      <>
        <ul class="gallery" data-gallery>
          {photos.map((p) => (
            <li id={`foto-${p.n}`} style={`--ar: ${(p.file.width / p.file.height).toFixed(3)}`}>
              <figure>
                <a
                  href={p.large.src}
                  data-lb
                  data-avif={p.large.avif}
                  data-webp={p.large.webp}
                  data-alt={p.alt}
                  data-caption={p.caption}
                  aria-label={`${ui.galleryOpen}: ${p.alt}`}
                >
                  <div class="frame">
                    <Img src={p.file} alt={p.alt} sizes="(min-width: 1024px) 480px, (min-width: 750px) 45vw, 70vw" />
                  </div>
                </a>
                {p.caption && <figcaption set:html={txt(p.caption)} />}
              </figure>
            </li>
          ))}
        </ul>
        <dialog class="lightbox" aria-label={gallery.data.title} data-lightbox data-of={ui.galleryOf} tabindex="-1">
          <div class="lightbox__top">
            <span class="lightbox__count" data-lb-count aria-live="polite" />
            <button type="button" class="lb-btn" data-lb-close aria-label={ui.galleryClose}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
          <div class="lightbox__stage" data-lb-stage>
            <button type="button" class="lb-btn lightbox__side lightbox__side--prev" data-lb-prev aria-label={ui.galleryPrev}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            </button>
            <picture>
              <source type="image/avif" sizes="100vw" data-lb-avif />
              <img alt="" sizes="100vw" data-lb-img />
            </picture>
            <button type="button" class="lb-btn lightbox__side lightbox__side--next" data-lb-next aria-label={ui.galleryNext}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>
          <div class="lightbox__bottom">
            <p class="lightbox__caption" data-lb-caption />
            <div class="lightbox__thumbs" role="group" aria-label={ui.galleryThumbs} data-lb-thumbs />
          </div>
        </dialog>
      </>
    )
  }
</Section>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((list) => {
    const dialog = list.nextElementSibling as HTMLDialogElement | null;
    if (!dialog?.matches('[data-lightbox]')) return;
    const links = [...list.querySelectorAll<HTMLAnchorElement>('[data-lb]')];
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const avif = dialog.querySelector<HTMLSourceElement>('[data-lb-avif]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-lb-stage]')!;
    const thumbs = dialog.querySelector<HTMLElement>('[data-lb-thumbs]')!;
    const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    const pageTheme = themeMeta?.content;
    const of = dialog.dataset.of ?? '/';
    let index = 0;

    // thumbnail strip, built from the gallery's own small images
    const thumbButtons = links.map((a, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'lightbox__thumb';
      b.setAttribute('aria-label', a.dataset.alt ?? '');
      const t = document.createElement('img');
      t.alt = '';
      t.loading = 'lazy';
      const small = a.querySelector('img');
      t.src = small?.currentSrc || small?.src || a.href;
      b.append(t);
      b.addEventListener('click', () => show(i));
      thumbs.append(b);
      return b;
    });
    const preload = (i: number) => {
      const a = links[(i + links.length) % links.length];
      const p = new Image();
      p.srcset = a.dataset.webp ?? '';
      p.sizes = '100vw';
      p.src = a.href;
    };

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const a = links[index];
      img.classList.remove('is-in');
      avif.srcset = a.dataset.avif ?? '';
      img.srcset = a.dataset.webp ?? '';
      img.src = a.href;
      img.alt = a.dataset.alt ?? '';
      // fade in once decoded; never leave the photo hidden
      const reveal = () => img.classList.add('is-in');
      img.decode().then(reveal, reveal);
      setTimeout(reveal, 700);
      caption.textContent = a.dataset.caption ?? '';
      caption.hidden = !a.dataset.caption;
      count.textContent = `${index + 1} ${of} ${links.length}`;
      thumbButtons.forEach((b, n) => b.toggleAttribute('aria-current', n === index));
      thumbButtons[index].scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      history.replaceState(null, '', `#${a.closest('li')!.id}`);
      preload(index + 1);
      preload(index - 1);
    };
    const open = (i: number) => {
      show(i);
      if (!dialog.open) {
        dialog.showModal();
        // focus the viewer itself, not the close button (no ring on open);
        // the arrow keys and Escape still work
        dialog.focus();
      }
      thumbButtons[index].scrollIntoView({ block: 'nearest', inline: 'center' });
      if (themeMeta) themeMeta.content = '#10150f';
    };

    links.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        open(i);
      }),
    );
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    // put the page back: browser bar colour, address, focus on the thumbnail.
    // Run directly by our own close paths, and on close/cancel for Escape.
    const restore = () => {
      if (themeMeta && pageTheme) themeMeta.content = pageTheme;
      if (location.hash) history.replaceState(null, '', location.pathname + location.search);
      links[index].focus({ preventScroll: true });
    };
    const close = () => {
      dialog.close();
      restore();
    };
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', close);
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('cancel', restore);
    dialog.addEventListener('close', restore);

    // swipe
    let startX: number | null = null;
    stage.addEventListener('pointerdown', (e) => (startX = e.clientX));
    stage.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
    // click on the dark area around the photo closes
    dialog.addEventListener('click', (e) => {
      if (e.target === stage) close();
    });

    // a shared link such as #foto-3 opens that photo
    const fromHash = links.findIndex((a) => `#${a.closest('li')!.id}` === location.hash);
    if (fromHash >= 0) open(fromHash);
  });
</script>
