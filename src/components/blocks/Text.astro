---
/* Long-form copy (ea-blocco, "solo testo"). */
import type { Block } from '../../lib/content';
import Section from './Section.astro';
import Img from '../Img.astro';
import { md } from '../../lib/text';

interface Props {
  block: Extract<Block, { type: 'text' }>;
  id: string;
}
const { block: b, id } = Astro.props;
const body = await md(b.body);
---

<Section {...b} headingId={id}>
  {
    b.image && (
      <div slot="head" class="frame text__photo">
        <Img src={b.image} alt={b.alt ?? ''} sizes="(min-width: 1024px) 460px, 100vw" />
      </div>
    )
  }
  <div class="prose" set:html={body} />
</Section>
