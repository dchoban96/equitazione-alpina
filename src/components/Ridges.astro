---
/* Three mountain profiles (ea-hero "creste"), drawn at build time as inline
   SVG so they need no JavaScript. Same wave formula as the theme script.
   Static for now: the theme's endless drift is listed as not fitting the
   three allowed kinds of motion (reference/ANIMATIONS.md). */
interface Props {
  fixed?: boolean;
}
const { fixed = false } = Astro.props;

const W = 1200;
const H = 900;
const layers = [
  { cls: 'r1', base: 0.86, amp: [46, 22, 11], off: 0 },
  { cls: 'r2', base: 0.93, amp: [62, 26, 13], off: 1.7 },
  { cls: 'r3', base: 1.0, amp: [80, 30, 16], off: 3.4 },
];
const crest = (base: number, amp: number[], off: number) => {
  let d = '';
  for (let x = 0; x <= W; x += 6) {
    const t = (x / W) * Math.PI * 2;
    const y =
      H * base - 120 - amp[0] * Math.sin(t + off) - amp[1] * Math.sin(t * 3 + off * 1.4) - amp[2] * Math.sin(t * 5 + off * 2.1);
    d += `${x === 0 ? 'M' : 'L'}${x} ${y.toFixed(1)}`;
  }
  return d;
};
const paths = layers.map((l) => {
  const line = crest(l.base, l.amp, l.off);
  return { cls: l.cls, line, fill: `${line}L${W} ${H}L0 ${H}Z` };
});
---

<div class:list={['ridges', { 'ridges--fixed': fixed }]} aria-hidden="true">
  {
    paths.map((p) => (
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
        <path class={p.cls} d={p.fill} />
        <path class="line" d={p.line} />
      </svg>
    ))
  }
</div>
