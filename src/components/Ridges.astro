---
/* Three mountain profiles (ea-hero "creste"), drawn at build time as inline
   SVG. Each profile is a range of pointed peaks placed at random (seeded, so
   every build draws the same mountains) on a slowly rolling base. Distances
   are measured around the loop, so the profile repeats seamlessly: each layer
   draws three periods and drifts sideways by exactly one. Only transform is
   animated; tile widths and loop times are in layout.css.

   `part` splits the layers when the ridges are fixed to the viewport:
   "back" (far and middle profiles, behind the page) and "front" (the nearest
   profile, above the page, so content rises from behind it). */
interface Props {
  fixed?: boolean;
  part?: 'all' | 'back' | 'front';
}
const { fixed = false, part = 'all' } = Astro.props;

const P = 1200; // one period, in SVG units
const H = 900;
const REPEAT = 3; // periods per layer: covers wide screens while drifting

// count peaks per period; height and half-width ranges in SVG units;
// pow > 1 makes the slopes slightly concave, so the tops stay sharp
const layers = [
  { cls: 'r1', seed: 11, base: 0.86, count: 11, height: [60, 200], width: [70, 190], pow: 1.25, front: false },
  { cls: 'r2', seed: 23, base: 0.93, count: 10, height: [50, 170], width: [80, 200], pow: 1.2, front: false },
  { cls: 'r3', seed: 37, base: 1.0, count: 9, height: [40, 140], width: [90, 220], pow: 1.15, front: true },
].filter((l) => part === 'all' || (part === 'front') === l.front);

function rng(seed: number) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function profile(l: (typeof layers)[number]) {
  const r = rng(l.seed);
  const span = (range: number[]) => range[0] + r() * (range[1] - range[0]);
  const peaks = Array.from({ length: l.count }, () => ({ x: r() * P, h: span(l.height), w: span(l.width) }));
  const o = r() * 6;
  return (x: number) => {
    let top = 0;
    for (const p of peaks) {
      let dx = Math.abs((((x - p.x) % P) + P) % P);
      dx = Math.min(dx, P - dx); // distance around the loop
      const u = dx / p.w;
      if (u < 1) top = Math.max(top, p.h * Math.pow(1 - u, l.pow));
    }
    const t = (x / P) * Math.PI * 2;
    const roll = 22 * Math.sin(t + o) + 9 * Math.sin(3 * t + o * 2) + 4 * Math.sin(17 * t + o);
    return H * l.base - 120 - top - roll;
  };
}

const W = P * REPEAT;
const shapes = layers.map((l) => {
  const y = profile(l);
  let line = '';
  for (let x = 0; x <= W; x += 6) line += `${x === 0 ? 'M' : 'L'}${x} ${y(x).toFixed(1)}`;
  return { cls: l.cls, line, fill: `${line}L${W} ${H}L0 ${H}Z` };
});
---

<div class:list={['ridges', `ridges--${part}`, { 'ridges--fixed': fixed }]} aria-hidden="true">
  {
    shapes.map((s) => (
      <svg class:list={['ridge', s.cls]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
        <path d={s.fill} />
        <path d={s.line} fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
      </svg>
    ))
  }
</div>
